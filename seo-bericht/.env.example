# Kopieren nach .env und ausfüllen:  cp .env.example .env
# .env kommt NIE ins Git-Repo (steht in .gitignore).

# --- Allgemein ---
PRAXIS_NAME=Praxis für Psychotherapie
ANREDE=Sie-Form
GRUSS=Viele Grüße aus der Agentur

# --- Phase 2: Google Search Console ---
# Property genau so, wie sie in der Search Console heißt:
#   Domain-Property:  sc-domain:example.de     URL-Property:  https://www.example.de/
GSC_PROPERTY=
GOOGLE_SERVICE_ACCOUNT_JSON=geheim/service-account.json

# --- Phase 2: WordPress (Anwendungspasswort, NICHT das Login-Passwort) ---
WP_SITE=https://www.example.de
WP_USER=
WP_APP_PASSWORD=

# --- Phase 3: Claude ---
ANTHROPIC_API_KEY=

# --- Phase 4: WhatsApp Cloud API (developers.facebook.com → deine App → WhatsApp) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Frei ausgedachtes Passwort, das du beim Einrichten des Webhooks bei Meta einträgst:
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v22.0
# Nummern im internationalen Format ohne + und ohne Leerzeichen, z. B. 4917612345678
MEINE_WHATSAPP=
KUNDIN_WHATSAPP=
WHATSAPP_VORLAGE_KUNDIN=seo_zwischenstand
# Vorlage für die automatische Monatsnachricht an dich (Phase 5)
WHATSAPP_VORLAGE_ICH=seo_bericht_fertig

# --- Phase 4: Server ---
OEFFENTLICHE_URL=https://seo.deine-domain.de
PORT=8000
